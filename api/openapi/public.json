{
  "components" : {
    "schemas" : {
      "AddSpaceMemberRequest" : {
        "description" : "A membership to add",
        "properties" : {
          "issuer" : {
            "description" : "The OIDC issuer of the member",
            "example" : "https://issuer.example.com",
            "maxLength" : 255,
            "type" : "string"
          },
          "role" : {
            "$ref" : "#/components/schemas/SpaceRole",
            "description" : "The role in the space"
          },
          "subject" : {
            "description" : "The OIDC subject of the member",
            "example" : "user-42",
            "maxLength" : 255,
            "type" : "string"
          }
        },
        "required" : [ "issuer", "role", "subject" ],
        "type" : "object"
      },
      "ChangeSpaceMemberRoleRequest" : {
        "description" : "The new role of a member",
        "properties" : {
          "role" : {
            "$ref" : "#/components/schemas/SpaceRole",
            "description" : "The role in the space"
          }
        },
        "required" : [ "role" ],
        "type" : "object"
      },
      "CreateSpaceRequest" : {
        "description" : "The desired state of a new space",
        "properties" : {
          "name" : {
            "description" : "The display name, 1-100 characters after trimming",
            "example" : "Acme",
            "maxLength" : 100,
            "type" : "string"
          },
          "slug" : {
            "description" : "The stable space slug",
            "example" : "acme",
            "maxLength" : 40,
            "minLength" : 3,
            "pattern" : "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
            "type" : "string"
          }
        },
        "required" : [ "name", "slug" ],
        "type" : "object"
      },
      "CursorPageSpaceMemberResponse" : {
        "properties" : {
          "items" : {
            "description" : "The items on this page",
            "items" : {
              "$ref" : "#/components/schemas/SpaceMemberResponse"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "description" : "The cursor of the next page, or null on the last page",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "items", "nextCursor" ],
        "type" : "object"
      },
      "CursorPageSpaceResponse" : {
        "properties" : {
          "items" : {
            "description" : "The items on this page",
            "items" : {
              "$ref" : "#/components/schemas/SpaceResponse"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "description" : "The cursor of the next page, or null on the last page",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "items", "nextCursor" ],
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "admin" : {
            "description" : "Whether the user is an instance administrator",
            "type" : "boolean"
          },
          "issuer" : {
            "description" : "The OIDC issuer of the authenticated user",
            "type" : "string"
          },
          "subject" : {
            "description" : "The OIDC subject of the authenticated user",
            "type" : "string"
          }
        },
        "required" : [ "admin", "issuer", "subject" ],
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "code" : {
            "enum" : [ "bad_request", "validation_failed", "invalid_body", "invalid_cursor", "unauthenticated", "forbidden", "not_found", "method_not_allowed", "not_acceptable", "unsupported_media_type", "version_conflict", "internal_error", "slug_taken", "invalid_name", "invalid_slug", "invalid_subject", "invalid_issuer" ],
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "properties" : {
                "code" : {
                  "type" : "string"
                },
                "params" : {
                  "additionalProperties" : true,
                  "type" : "object"
                },
                "pointer" : {
                  "type" : "string"
                }
              },
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PutSpaceRequest" : {
        "description" : "The desired state of a space",
        "properties" : {
          "name" : {
            "description" : "The display name, 1-100 characters after trimming",
            "example" : "Acme",
            "maxLength" : 100,
            "type" : "string"
          },
          "version" : {
            "description" : "The version the caller read; omit to rename without a version condition. A concurrent change of the same space can still answer 409.",
            "example" : 1,
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "SpaceMemberResponse" : {
        "description" : "A membership of a space",
        "properties" : {
          "issuer" : {
            "description" : "The OIDC issuer of the member",
            "example" : "https://issuer.example.com",
            "type" : "string"
          },
          "role" : {
            "$ref" : "#/components/schemas/SpaceRole",
            "description" : "The role in the space"
          },
          "subject" : {
            "description" : "The OIDC subject of the member",
            "example" : "user-42",
            "type" : "string"
          }
        },
        "required" : [ "issuer", "role", "subject" ],
        "type" : "object"
      },
      "SpaceResponse" : {
        "description" : "A space as seen by the caller",
        "properties" : {
          "name" : {
            "description" : "The display name",
            "example" : "Acme",
            "type" : "string"
          },
          "role" : {
            "$ref" : "#/components/schemas/SpaceRole",
            "description" : "The caller's membership role, or null for an Admin who is not a member",
            "type" : "null"
          },
          "slug" : {
            "description" : "The stable space slug",
            "example" : "acme",
            "pattern" : "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
            "type" : "string"
          },
          "version" : {
            "description" : "The version growing whenever the name changes",
            "example" : 1,
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "name", "role", "slug", "version" ],
        "type" : "object"
      },
      "SpaceRole" : {
        "enum" : [ "EDITOR", "VIEWER" ],
        "type" : [ "string", "null" ]
      }
    }
  },
  "info" : {
    "title" : "wakey API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
