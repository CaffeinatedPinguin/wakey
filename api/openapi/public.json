{
  "components" : {
    "schemas" : {
      "CurrentUser" : {
        "properties" : {
          "admin" : {
            "description" : "Whether the user is an instance administrator",
            "type" : "boolean"
          },
          "subject" : {
            "description" : "The OIDC subject of the authenticated user",
            "type" : "string"
          }
        },
        "required" : [ "admin", "subject" ],
        "type" : "object"
      },
      "CursorPageSpaceResponse" : {
        "properties" : {
          "items" : {
            "description" : "The items on this page",
            "items" : {
              "$ref" : "#/components/schemas/SpaceResponse"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "description" : "The cursor of the next page, or null on the last page",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "items", "nextCursor" ],
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "properties" : {
                "code" : {
                  "type" : "string"
                },
                "params" : {
                  "additionalProperties" : true,
                  "type" : "object"
                },
                "pointer" : {
                  "type" : "string"
                }
              },
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PutSpaceRequest" : {
        "description" : "The desired state of a space",
        "properties" : {
          "name" : {
            "description" : "The display name, 1-100 characters after trimming",
            "example" : "Acme",
            "maxLength" : 100,
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "SpaceResponse" : {
        "description" : "A space as seen by the caller",
        "properties" : {
          "name" : {
            "description" : "The display name",
            "example" : "Acme",
            "type" : "string"
          },
          "role" : {
            "description" : "The caller's membership role, or null for an Admin who is not a member",
            "enum" : [ "EDITOR", "VIEWER" ],
            "type" : [ "string", "null" ]
          },
          "slug" : {
            "description" : "The stable space slug",
            "example" : "acme",
            "pattern" : "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
            "type" : "string"
          },
          "version" : {
            "description" : "The version growing whenever the name changes",
            "example" : 1,
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "name", "role", "slug", "version" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "wakey API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUser"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Authentication is required."
          }
        },
        "summary" : "Return the authenticated user",
        "tags" : [ "me-controller" ]
      }
    },
    "/api/v1/spaces" : {
      "get" : {
        "operationId" : "listSpaces",
        "parameters" : [ {
          "description" : "The page size, at least 1; values above the instance maximum are capped.",
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CursorPageSpaceResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The cursor or the limit is invalid."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Authentication is required."
          }
        },
        "summary" : "List the spaces visible to the caller",
        "tags" : [ "spaces-controller" ]
      }
    },
    "/api/v1/spaces/{slug}" : {
      "get" : {
        "operationId" : "getSpace",
        "parameters" : [ {
          "in" : "path",
          "name" : "slug",
          "required" : true,
          "schema" : {
            "pattern" : "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SpaceResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The slug is invalid."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Authentication is required."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The space was not found."
          }
        },
        "summary" : "Read one space visible to the caller",
        "tags" : [ "spaces-controller" ]
      },
      "put" : {
        "description" : "A rename is last-write-wins unless an If-Match precondition is sent. Send If-None-Match: * to create the space only when the slug is free, and If-Match: \"<version>\" to rename only the version the caller read.",
        "operationId" : "putSpace",
        "parameters" : [ {
          "in" : "path",
          "name" : "slug",
          "required" : true,
          "schema" : {
            "pattern" : "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
            "type" : "string"
          }
        }, {
          "description" : "Send * to create the space only when the slug is free.",
          "in" : "header",
          "name" : "If-None-Match",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The quoted space version to rename, for example \"1\".",
          "in" : "header",
          "name" : "If-Match",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PutSpaceRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SpaceResponse"
                }
              }
            },
            "description" : "OK"
          },
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SpaceResponse"
                }
              }
            },
            "description" : "The space was created."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The request is invalid or a precondition header is malformed."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Authentication is required."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The caller is not allowed to create or rename spaces."
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The slug is taken or the If-Match version is stale."
          }
        },
        "summary" : "Create or rename a space idempotently",
        "tags" : [ "spaces-controller" ]
      }
    }
  },
  "servers" : [ {
    "description" : "Generated server url",
    "url" : "http://localhost"
  } ]
}
