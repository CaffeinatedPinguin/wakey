          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Authentication is required."
          }
        },
        "summary" : "Return the authenticated user",
        "tags" : [ "me-controller" ]
      }
    },
    "/api/v1/spaces" : {
