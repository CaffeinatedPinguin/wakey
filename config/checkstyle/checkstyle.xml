<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>

  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.suppressions.file}"/>
    <property name="optional" value="false"/>
  </module>

  <module name="FileLength">
    <property name="max" value="400"/>
  </module>

  <module name="TreeWalker">
    <module name="NeedBraces">
      <property name="allowSingleLineStatement" value="false"/>
    </module>
    <module name="NestedIfDepth">
      <property name="max" value="1"/>
    </module>
    <module name="NestedForDepth">
      <property name="max" value="1"/>
    </module>
    <module name="NestedTryDepth">
      <property name="max" value="1"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="4"/>
    </module>
    <module name="MethodLength">
      <property name="max" value="40"/>
      <property name="countEmpty" value="false"/>
    </module>
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
    </module>
    <module name="BooleanExpressionComplexity">
      <property name="max" value="3"/>
    </module>
    <module name="AvoidStarImport"/>
    <module name="EmptyCatchBlock">
      <!-- A plain comment must not excuse an empty catch block: this pattern never matches. -->
      <property name="commentFormat" value="(?!)"/>
    </module>
    <module name="MatchXpath">
      <!-- A catch block must rethrow, wrap with the original cause, or pass the caught exception to a call. -->
      <property name="query" value="//LITERAL_CATCH[not(.//LITERAL_THROW)][not(.//METHOD_CALL/ELIST/EXPR/IDENT/@text = ./PARAMETER_DEF/IDENT/@text)]"/>
      <message key="matchxpath.match" value="A catch block must rethrow the exception, wrap it with the original cause, or pass the caught exception to a call (for example a logger), otherwise the stack trace is lost."/>
    </module>
    <module name="InnerAssignment"/>
    <module name="IllegalCatch"/>
    <module name="IllegalThrows"/>
    <module name="NPathComplexity">
      <property name="max" value="200"/>
    </module>
    <module name="ClassFanOutComplexity">
      <property name="max" value="20"/>
    </module>
    <module name="ReturnCount">
      <property name="max" value="2"/>
      <property name="maxForVoid" value="1"/>
    </module>
    <module name="ParameterAssignment"/>
    <module name="ModifiedControlVariable"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="EqualsHashCode"/>
    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor">
      <property name="ignoreAnnotatedBy" value="SpringBootApplication"/>
    </module>
    <module name="VisibilityModifier"/>
    <module name="MutableException"/>
  </module>
</module>
