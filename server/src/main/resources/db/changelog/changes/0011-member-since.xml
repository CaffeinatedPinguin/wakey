<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="member-since" author="wakey">
    <!-- postgres-only: native TIMESTAMPTZ column type, like the table registered in 0004-spaces.xml; another database needs its own timezone-aware type. Existing memberships start now;
         a removal deletes the row, so a later invitation gets a fresh value. -->
    <addColumn tableName="space_member">
      <column name="since" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>
</databaseChangeLog>
