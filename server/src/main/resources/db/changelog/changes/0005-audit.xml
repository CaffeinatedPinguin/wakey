<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="audit-event" author="wakey">
    <!-- postgres-only: native UUID and TIMESTAMPTZ column types; another database needs its own binary and timezone-aware equivalents. -->
    <createTable tableName="audit_event">
      <column name="id" type="UUID">
        <constraints primaryKey="true" primaryKeyName="pk_audit_event" nullable="false"/>
      </column>
      <column name="occurred_at" type="TIMESTAMPTZ">
        <constraints nullable="false"/>
      </column>
      <column name="actor_subject" type="VARCHAR(100)"/>
      <column name="actor_kind" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="source" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="space_id" type="UUID"/>
      <column name="action" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="object_type" type="VARCHAR(32)">
        <constraints nullable="false"/>
      </column>
      <column name="object_id" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="outcome" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="details" type="TEXT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <sql>
      ALTER TABLE audit_event
        ADD CONSTRAINT ck_audit_event_actor_kind CHECK (actor_kind IN ('USER', 'TOKEN', 'SYSTEM'));
      ALTER TABLE audit_event
        ADD CONSTRAINT ck_audit_event_source CHECK (source IN ('UI', 'API', 'FILE', 'SYSTEM'));
      ALTER TABLE audit_event
        ADD CONSTRAINT ck_audit_event_outcome CHECK (outcome IN ('SUCCESS', 'DENIED'));

      CREATE INDEX ix_audit_event_object
        ON audit_event (object_type, object_id, occurred_at DESC);
      CREATE INDEX ix_audit_event_space
        ON audit_event (space_id, occurred_at DESC);
    </sql>
  </changeSet>
</databaseChangeLog>
