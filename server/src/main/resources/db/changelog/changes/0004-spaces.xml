<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="spaces" author="wakey">
    <!-- postgres-only: native UUID and TIMESTAMPTZ column types; another database needs its own binary and timezone-aware equivalents. -->
    <createTable tableName="space">
      <column name="id" type="UUID">
        <constraints primaryKey="true" primaryKeyName="pk_space" nullable="false"/>
      </column>
      <column name="slug" type="VARCHAR(40)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_space_slug"/>
      </column>
      <column name="name" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMPTZ">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMPTZ">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createTable tableName="space_member">
      <column name="space_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="issuer" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="subject" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="role" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="space_member"
                   columnNames="space_id, issuer, subject"
                   constraintName="pk_space_member"/>
    <addForeignKeyConstraint baseTableName="space_member"
                             baseColumnNames="space_id"
                             constraintName="fk_space_member_space"
                             referencedTableName="space"
                             referencedColumnNames="id"
                             onDelete="CASCADE"/>
    <sql>
      ALTER TABLE space_member
        ADD CONSTRAINT ck_space_member_role CHECK (role IN ('EDITOR', 'VIEWER'));
    </sql>
    <createIndex tableName="space_member" indexName="ix_space_member_issuer_subject">
      <column name="issuer"/>
      <column name="subject"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
